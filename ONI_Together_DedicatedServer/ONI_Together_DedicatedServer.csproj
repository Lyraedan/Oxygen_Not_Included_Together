    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DoNotBuildAsMod>true</DoNotBuildAsMod>
    <ExcludeGameLibs>true</ExcludeGameLibs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Networking\Dedicated\RelayProtocol.cs" Link="Shared\RelayProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
