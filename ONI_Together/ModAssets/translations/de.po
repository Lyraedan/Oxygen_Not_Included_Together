#. ONI_Together.STRINGS.UI.MP_OVERLAY.CLIENT.RELAY.LOADING_COLONY
msgctxt "ONI_Together.STRINGS.UI.MP_OVERLAY.CLIENT.RELAY.LOADING_COLONY"
